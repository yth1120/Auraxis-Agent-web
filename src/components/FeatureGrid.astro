---
import {
  RefreshCw,
  Workflow,
  Braces,
  ShieldCheck,
  Lock,
  Puzzle,
  Database,
  Cpu,
  Blocks,
} from 'lucide-react';

const FEATURES = [
  { icon: RefreshCw, titleKey: 'feature1_title', descKey: 'feature1_desc' },
  { icon: Workflow, titleKey: 'feature2_title', descKey: 'feature2_desc' },
  { icon: Braces, titleKey: 'feature3_title', descKey: 'feature3_desc' },
  { icon: ShieldCheck, titleKey: 'feature4_title', descKey: 'feature4_desc' },
  { icon: Lock, titleKey: 'feature5_title', descKey: 'feature5_desc' },
  { icon: Puzzle, titleKey: 'feature6_title', descKey: 'feature6_desc' },
  { icon: Database, titleKey: 'feature7_title', descKey: 'feature7_desc' },
  { icon: Cpu, titleKey: 'feature8_title', descKey: 'feature8_desc' },
  { icon: Blocks, titleKey: 'feature9_title', descKey: 'feature9_desc' },
];
---

<section id="features" class="py-16 border-t border-brand-hairline dark:border-brand-border/80 transition-colors">
  <div class="text-center max-w-3xl mx-auto mb-14">
    <h2 class="text-3xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="features_title">外置于系统的透明能力</h2>
    <p class="text-brand-muted mt-3" data-i18n="features_subtitle">彻底打开大模型与操作系统之间的「黑盒」。Auraxis 不仅发送 prompt，更是一整套可审计的代码执行引擎。</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-[1080px] mx-auto">
    {FEATURES.map(({ icon: Icon, titleKey, descKey }) => (
      <div class="group bg-white dark:bg-brand-card/60 border border-brand-hairline dark:border-brand-border p-6 rounded-lg hover:border-brand-accent/40 transition-colors">
        <div class="w-10 h-10 rounded-md bg-brand-accent/10 flex items-center justify-center text-brand-accent mb-4">
          <Icon className="w-5 h-5" aria-hidden="true" />
        </div>
        <h3 class="text-base font-medium text-ink dark:text-ivory" data-i18n={titleKey}></h3>
        <p class="text-[13px] text-brand-muted mt-2 leading-relaxed" data-i18n={descKey}></p>
      </div>
    ))}
  </div>
</section>
