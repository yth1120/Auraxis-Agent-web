---
// Auraxis 官方网站 — 单页主入口（极简产品介绍式）
// Hybrid 模式：首页保持预渲染为静态 HTML，API 路由动态执行
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import SolutionSection from '../components/SolutionSection.astro';
import DemoSection from '../components/DemoSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />

  <main class="relative z-10">
    <!-- 只展示重点：定位 → 核心能力 → 实况演示 → 下载 -->
    <HeroSection />
    <SolutionSection />
    <DemoSection />
    <DownloadSection />
  </main>

  <Footer />
</BaseLayout>
