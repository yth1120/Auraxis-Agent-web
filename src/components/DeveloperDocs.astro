---
import { Terminal, Check, Copy, ArrowUpRight, FileText, ListChecks, Blocks, Braces } from 'lucide-react';

const REPO_URL = 'https://github.com/yth1120/Auraxis-Agent';

const DOC_LINKS = [
  { href: `${REPO_URL}/blob/main/docs/README.md`, key: 'footer_contrib_1', label: '架构文档 (docs/README)', icon: FileText },
  { href: `${REPO_URL}/blob/main/AGENTS.md`, key: 'footer_contrib_2', label: '工程规范 (AGENTS.md)', icon: ListChecks },
  { href: `${REPO_URL}/blob/main/packages/auraxis-sdk/README.md`, key: 'footer_contrib_3', label: 'TypeScript SDK', icon: Blocks },
  { href: `${REPO_URL}/blob/main/python/auraxis_sdk/README.md`, key: 'footer_contrib_4', label: 'Python SDK', icon: Braces },
  { href: 'https://github.com/yth1120/Auraxis-CLI#readme', key: 'dev_link_cli', label: 'Auraxis CLI — 独立的本地 Agent 命令行工作台', icon: Terminal },
];
---

<section id="developer-docs" class="py-20 border-t border-brand-hairline dark:border-brand-border/80 transition-colors">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-14 items-center">
    <div class="reveal lg:col-span-5 space-y-7">
      <div class="space-y-4">
        <div class="text-xs font-mono text-brand-accent tracking-[0.2em] uppercase">Developers</div>
        <h2 class="text-3xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="dev_title">本地开发</h2>
        <p class="text-brand-muted leading-relaxed" data-i18n="dev_description">Auraxis Agent 的源码在 GitHub 上，主进程与渲染进程均为 TypeScript。下面的命令可以克隆项目并在本地启动开发。</p>
      </div>

      <!-- 文档链接列表 -->
      <div class="flex flex-col">
        {DOC_LINKS.map(({ href, key, label, icon: Icon }) => (
          <a href={href} target="_blank" rel="noopener noreferrer"
            class="group flex items-center justify-between py-3 border-b border-brand-hairline dark:border-brand-border/60 text-sm text-brand-muted hover:text-ink dark:hover:text-ivory transition-colors">
            <span class="flex items-center gap-3">
              <Icon className="w-4 h-4 text-brand-accent" aria-hidden="true" />
              <span data-i18n={key}>{label}</span>
            </span>
            <ArrowUpRight className="w-3.5 h-3.5 text-brand-faint group-hover:text-brand-accent transition-colors" aria-hidden="true" />
          </a>
        ))}
      </div>

      <!-- 工程指标 -->
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-5 h-5 rounded-full bg-brand-accent/15 flex items-center justify-center text-brand-accent mt-0.5"><Check className="w-3.5 h-3.5" aria-hidden="true" /></div>
          <span class="text-sm text-brand-ink2 dark:text-brand-text" data-i18n="dev_check1">Vitest 覆盖率：行/语句 85.42% · 分支 79.08% · 函数 86.63%（门槛 80 / 70 / 80）</span>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-5 h-5 rounded-full bg-brand-accent/15 flex items-center justify-center text-brand-accent mt-0.5"><Check className="w-3.5 h-3.5" aria-hidden="true" /></div>
          <span class="text-sm text-brand-ink2 dark:text-brand-text" data-i18n="dev_check2">生产环境启用严格 CSP，主进程与渲染进程隔离</span>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-5 h-5 rounded-full bg-brand-accent/15 flex items-center justify-center text-brand-accent mt-0.5"><Check className="w-3.5 h-3.5" aria-hidden="true" /></div>
          <span class="text-sm text-brand-ink2 dark:text-brand-text" data-i18n="dev_check3">237 个测试文件 · 1740 个用例 · 15 条 Playwright E2E 链路</span>
        </div>
      </div>
    </div>

    <div class="reveal lg:col-span-7">
      <div class="code-dark-box border border-brand-border rounded-xl overflow-hidden font-mono text-xs">
        <div class="bg-brand-black px-4 py-3 border-b border-brand-border flex items-center justify-between">
          <span class="text-brand-muted" data-i18n="dev_titlebar">快速克隆并启动开发</span>
          <span class="text-brand-faint font-bold" data-i18n="dev_titlebar_type">TypeScript / Vite</span>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <p class="text-brand-muted mb-2" data-i18n="dev_step1_comment">// 1. 克隆底层核心仓库</p>
            <div class="bg-brand-black/60 p-3 rounded border border-brand-border flex items-center justify-between group">
              <span class="text-brand-accent">{`git clone ${REPO_URL}`}</span>
              <button data-copy-text={`git clone ${REPO_URL}`} class="text-brand-muted hover:text-brand-ivory transition-colors p-1 rounded hover:bg-white/5" data-i18n-aria="dev_copy_button" data-i18n-title="dev_copy_title" aria-label="复制命令" title="点击复制"><Copy className="w-4 h-4" aria-hidden="true" /></button>
            </div>
          </div>
          <div>
            <p class="text-brand-muted mb-2" data-i18n="dev_step2_comment">// 2. 创建本地开发环境变量配置</p>
            <div class="bg-brand-black/60 p-3 rounded border border-brand-border flex items-center justify-between group">
              <span class="text-brand-text">cp .env.example .env</span>
              <button data-copy-text="cp .env.example .env" class="text-brand-muted hover:text-brand-ivory transition-colors p-1 rounded hover:bg-white/5" data-i18n-aria="dev_copy_button" data-i18n-title="dev_copy_title" aria-label="复制命令" title="点击复制"><Copy className="w-4 h-4" aria-hidden="true" /></button>
            </div>
          </div>
          <div>
            <p class="text-brand-muted mb-2" data-i18n="dev_step3_comment">// 3. 安装依赖并启动 Electron 联动调试开发</p>
            <div class="bg-brand-black/60 p-3 rounded border border-brand-border">
              <span class="text-brand-text block">npm install</span>
              <span class="text-brand-accent block">npm run electron:dev</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-copy-text]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy-text');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const iconEl = btn.querySelector('svg');
        if (iconEl) {
          const orig = iconEl.outerHTML;
          iconEl.outerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-check"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg>';
          setTimeout(() => { const r = btn.querySelector('svg'); if (r) r.outerHTML = orig; }, 1500);
        }
      } catch {}
    });
  });
</script>
