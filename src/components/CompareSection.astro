---
import { ShieldQuestion, ClipboardList, Zap, Check } from 'lucide-react';

const ROWS = [
  { labelKey: 'compare_row1_label', otherKey: 'compare_row1_other', auraxisKey: 'compare_row1_auraxis' },
  { labelKey: 'compare_row2_label', otherKey: 'compare_row2_other', auraxisKey: 'compare_row2_auraxis' },
  { labelKey: 'compare_row3_label', otherKey: 'compare_row3_other', auraxisKey: 'compare_row3_auraxis' },
  { labelKey: 'compare_row4_label', otherKey: 'compare_row4_other', auraxisKey: 'compare_row4_auraxis' },
];

const MODES = [
  { icon: ShieldQuestion, name: 'ask', titleKey: 'perm_ask_title', descKey: 'perm_ask_desc' },
  { icon: ClipboardList, name: 'plan', titleKey: 'perm_plan_title', descKey: 'perm_plan_desc' },
  { icon: Zap, name: 'afe', titleKey: 'perm_afe_title', descKey: 'perm_afe_desc' },
];
---

<section id="compare" class="py-20 border-t border-brand-hairline dark:border-brand-border/80 transition-colors">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="text-xs font-mono text-brand-accent tracking-[0.2em] uppercase mb-4">Compare</div>
      <h2 class="text-3xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="compare_title">Auraxis vs 普通 AI 助手</h2>
      <p class="text-brand-muted mt-3" data-i18n="compare_subtitle">同样是大模型驱动，差别在是否真正掌控执行链路。</p>
    </div>

    <!-- 对比表 -->
    <div class="max-w-4xl mx-auto overflow-hidden rounded-xl border border-brand-hairline dark:border-brand-border">
      <!-- 表头 -->
      <div class="grid grid-cols-3 text-sm">
        <div class="px-5 py-4 bg-black/[0.03] dark:bg-white/[0.03] border-b border-r border-brand-hairline dark:border-brand-border text-brand-faint font-mono text-xs" aria-hidden="true"></div>
        <div class="px-5 py-4 bg-black/[0.03] dark:bg-white/[0.03] border-b border-r border-brand-hairline dark:border-brand-border text-brand-muted font-medium" data-i18n="compare_other">普通 AI 助手</div>
        <div class="px-5 py-4 bg-brand-accent/5 border-b border-brand-hairline dark:border-brand-border text-brand-accent font-semibold" data-i18n="compare_auraxis">Auraxis</div>
      </div>

      <!-- 行 -->
      {ROWS.map(({ labelKey, otherKey, auraxisKey }) => (
        <div class="grid grid-cols-3 text-[13px] border-t border-brand-hairline dark:border-brand-border/60 first:border-t-0">
          <div class="px-5 py-4 border-r border-brand-hairline dark:border-brand-border/60 text-brand-faint font-mono text-xs flex items-center" data-i18n={labelKey}></div>
          <div class="px-5 py-4 border-r border-brand-hairline dark:border-brand-border/60 text-brand-muted" data-i18n={otherKey}></div>
          <div class="px-5 py-4 text-ink dark:text-ivory font-medium flex items-start gap-2">
            <Check className="w-3.5 h-3.5 text-brand-accent mt-0.5 flex-shrink-0" aria-hidden="true" />
            <span data-i18n={auraxisKey}></span>
          </div>
        </div>
      ))}
    </div>

    <!-- 三种权限模式 -->
    <div class="max-w-4xl mx-auto mt-8">
      <p class="text-center text-xs font-mono text-brand-faint uppercase tracking-[0.2em] mb-5" data-i18n="compare_modes_label">三种权限模式，按场景切换</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {MODES.map(({ icon: Icon, name, titleKey, descKey }) => (
          <div class="bg-white dark:bg-brand-card/60 border border-brand-hairline dark:border-brand-border rounded-xl px-5 py-4 hover:border-brand-accent/40 transition-colors">
            <div class="flex items-center gap-3 mb-2.5">
              <div class="w-8 h-8 rounded-md bg-brand-accent/10 flex items-center justify-center text-brand-accent flex-shrink-0">
                <Icon className="w-4 h-4" aria-hidden="true" />
              </div>
              <div class="min-w-0">
                <div class="text-[10px] font-mono text-brand-accent leading-none">{name}</div>
                <h3 class="text-[13px] font-medium text-ink dark:text-ivory truncate" data-i18n={titleKey}></h3>
              </div>
            </div>
            <p class="text-xs text-brand-muted leading-relaxed" data-i18n={descKey}></p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
