---
import { RefreshCw, Wrench, Workflow, Braces, ShieldCheck, Database } from 'lucide-react';

const CORE = [
  { icon: RefreshCw, titleKey: 'feature1_title', descKey: 'feature1_desc' },
  { icon: Wrench, titleKey: 'pillar2_title', descKey: 'pillar2_desc' },
  { icon: Workflow, titleKey: 'feature2_title', descKey: 'feature2_desc' },
  { icon: Braces, titleKey: 'feature3_title', descKey: 'feature3_desc' },
  { icon: ShieldCheck, titleKey: 'core5_title', descKey: 'core5_desc' },
  { icon: Database, titleKey: 'core6_title', descKey: 'core6_desc' },
];
---

<section id="features" class="py-20 border-t border-brand-hairline dark:border-brand-border/80 transition-colors">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="solution_title">核心能力</h2>
      <p class="text-brand-muted mt-3" data-i18n="solution_subtitle">从理解需求到验证交付，一条可审计的执行链路。</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {CORE.map(({ icon: Icon, titleKey, descKey }) => (
        <div class="bg-white dark:bg-brand-card/60 border border-brand-hairline dark:border-brand-border rounded-xl p-6 hover:border-brand-accent/40 transition-colors">
          <div class="w-9 h-9 rounded-md bg-brand-accent/10 flex items-center justify-center text-brand-accent mb-4">
            <Icon className="w-4 h-4" aria-hidden="true" />
          </div>
          <h3 class="text-sm font-medium text-ink dark:text-ivory" data-i18n={titleKey}></h3>
          <p class="text-[13px] text-brand-muted mt-1.5 leading-relaxed" data-i18n={descKey}></p>
        </div>
      ))}
    </div>
  </div>
</section>
