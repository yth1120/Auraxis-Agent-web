---
import { ArrowRight, BookOpen } from 'lucide-react';
const BASE = import.meta.env.BASE_URL;
---

<section id="top" class="relative pt-24 pb-24">
  <div class="max-w-6xl mx-auto px-6 mb-8 lg:mb-10">
    <a
      href="#download"
      data-i18n-aria="banner_label"
      aria-label="重点更新"
      class="reveal group inline-flex w-fit self-start max-w-full flex-wrap items-center gap-x-3 gap-y-1.5 px-2 py-1 rounded-lg transition-colors hover:bg-black/[0.03] hover:text-ink dark:hover:bg-white/[0.03] dark:hover:text-ivory focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent/40"
    >
      <span class="text-lg leading-none flex-shrink-0" aria-hidden="true">🎉</span>
      <span class="flex-shrink-0 text-xs font-mono text-brand-faint">v3.4.0</span>
      <p class="min-w-0 text-sm sm:text-base text-brand-muted leading-relaxed transition-colors group-hover:text-ink dark:group-hover:text-ivory" data-i18n="banner_text">
        v3.4.0 · 新增 Auraxis CLI（终端里的独立 Agent）· DeepSeek V4.1 Flash 原生多模态 · 任务可随时续跑 · 会话内自动更新
      </p>
      <span data-i18n="banner_link" class="flex items-center gap-1 text-sm font-medium text-brand-faint transition-colors group-hover:text-ink dark:group-hover:text-ivory whitespace-nowrap">
        查看详情 <span aria-hidden="true">→</span>
      </span>
    </a>
  </div>

  <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-[1fr_1.12fr] gap-10 lg:gap-12 items-center">
    <div class="text-center lg:text-left space-y-7">
      <h1 class="reveal text-4xl sm:text-5xl lg:text-5xl font-semibold tracking-tight leading-[1.15] text-ink dark:text-ivory" style="--reveal-delay: 120ms">
        <span data-i18n="hero_title_line1">Auraxis Agent</span><br />
        <span class="block mt-2 sm:mt-3" data-i18n="hero_title_line2">桌面端智能体工作台</span>
      </h1>

      <p class="reveal text-brand-muted text-base sm:text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0" data-i18n="hero_description" style="--reveal-delay: 240ms">
        Auraxis Agent 是一个基于 Electron 的桌面端智能体工作台（编码 / 文档 / 自动化），个人开发、MIT 开源。它提供 Chat / Work / Code 三模式、统一的 ReAct 步进引擎、71 个内置工具、多 Agent 调度、文档生成与云连接器，以及原生沙箱隔离。
      </p>

      <div class="reveal flex items-center justify-center lg:justify-start gap-3 pt-2" style="--reveal-delay: 380ms">
        <a href="#download" data-i18n="hero_cta_download" class="bg-ink dark:bg-ivory hover:bg-black/90 dark:hover:bg-white/90 text-ivory dark:text-ink font-medium text-sm h-10 px-7 inline-flex items-center gap-2 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent/40">
          <ArrowRight className="w-4 h-4" aria-hidden="true" />
          下载
        </a>
        <a href="#demo" data-i18n="hero_cta_docs" class="border border-brand-hairline dark:border-brand-border hover:bg-black/5 dark:hover:bg-white/5 text-ink dark:text-ivory font-medium text-sm h-10 px-7 inline-flex items-center gap-2 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent/40">
          <BookOpen className="w-4 h-4" aria-hidden="true" />
          查看演示
        </a>
      </div>

    </div>

    <div class="reveal" style="--reveal-delay: 300ms">
      <div class="terminal-dark-box border border-brand-border rounded-2xl overflow-hidden shadow-[0_24px_80px_-28px_rgba(0,0,0,0.5)] dark:shadow-[0_24px_80px_-28px_rgba(0,0,0,0.75)]">
        <img
          src={`${BASE}screenshots/auraxis-hero.jpg`}
          alt="Auraxis Agent 桌面端界面截图"
          data-i18n-alt="hero_image_alt"
          width="3078"
          height="1376"
          class="w-full h-auto block"
        />
      </div>
    </div>
  </div>

</section>
