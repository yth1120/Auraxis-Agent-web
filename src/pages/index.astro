---
// Auraxis 官方网站 — 单页主入口（叙事式布局）
// Hybrid 模式：首页保持预渲染为静态 HTML，API 路由动态执行
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ScreenshotSection from '../components/ScreenshotSection.astro';
import SolutionSection from '../components/SolutionSection.astro';
import DemoSection from '../components/DemoSection.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import ToolsMatrixSection from '../components/ToolsMatrixSection.astro';
import SafetySection from '../components/SafetySection.astro';
import EcosystemSection from '../components/EcosystemSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import FaqSection from '../components/FaqSection.astro';
import DeveloperDocs from '../components/DeveloperDocs.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />

  <main class="relative z-10">
    <!-- 结构：定位 → 界面截图 → 功能 → 演示 → 工具 → 安全 → 架构 → 集成 → 开发 → 获取 → FAQ -->
    <HeroSection />
    <ScreenshotSection />
    <SolutionSection />
    <DemoSection />
    <ToolsMatrixSection />
    <SafetySection />
    <ArchitectureSection />
    <EcosystemSection />
    <DeveloperDocs />
    <DownloadSection />
    <FaqSection />
  </main>

  <Footer />
</BaseLayout>
