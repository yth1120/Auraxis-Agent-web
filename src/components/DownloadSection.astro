---
import SmartDownloader from '../react/SmartDownloader';
import { MonitorCheck, ListChecks, Terminal, Copy } from 'lucide-react';
import releases from '../data/releases.json';
---

<!-- 收尾 CTA：全宽深色横幅（任何主题下保持深色） -->
<section id="download" class="py-20 border-t border-brand-hairline dark:border-brand-border/80 transition-colors">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal terminal-dark-box border border-brand-border rounded-2xl px-6 py-14 sm:px-12">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="text-xs font-mono text-brand-accent tracking-[0.2em] uppercase mb-4">Download</div>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-ivory" data-i18n="download_title">下载 Auraxis Agent</h2>
        <p class="text-brand-muted mt-3" data-i18n="download_subtitle">v3.2.0 · Electron 44 · MIT 开源。安装包托管在 GitHub Releases，点击下方按钮即可下载。</p>
      </div>

      <div class="max-w-2xl mx-auto mb-10">
        <SmartDownloader client:visible />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl mx-auto">
        <div class="bg-white/[0.04] border border-brand-border rounded-xl p-5">
          <h3 class="text-sm font-medium text-ivory mb-3.5 flex items-center gap-2">
            <MonitorCheck className="w-4 h-4 text-brand-accent" aria-hidden="true" />
            <span data-i18n="download_requirements_title">系统要求</span>
          </h3>
          <ul class="space-y-2.5">
            <li class="flex items-start gap-2 text-[13px] text-brand-muted"><span class="w-1 h-1 rounded-full bg-brand-accent mt-1.5 flex-shrink-0" aria-hidden="true"></span><span data-i18n="download_req1">Windows 10+ (x64) · macOS 12+ · Linux (x64)</span></li>
            <li class="flex items-start gap-2 text-[13px] text-brand-muted"><span class="w-1 h-1 rounded-full bg-brand-accent mt-1.5 flex-shrink-0" aria-hidden="true"></span><span data-i18n="download_req2">内置 Node 24 运行时，无需额外安装</span></li>
            <li class="flex items-start gap-2 text-[13px] text-brand-muted"><span class="w-1 h-1 rounded-full bg-brand-accent mt-1.5 flex-shrink-0" aria-hidden="true"></span><span data-i18n="download_req3">Shell 工具建议使用 Git Bash 或 PowerShell</span></li>
          </ul>
        </div>

        <div class="bg-white/[0.04] border border-brand-border rounded-xl p-5">
          <h3 class="text-sm font-medium text-ivory mb-3.5 flex items-center gap-2">
            <ListChecks className="w-4 h-4 text-brand-accent" aria-hidden="true" />
            <span data-i18n="download_changelog_title">v3.2.0 更新内容</span>
          </h3>
          <ul class="space-y-2.5">
            {releases.changelog.map((item) => (
              <li class="text-[13px] text-brand-muted flex items-start gap-2">
                <span class="text-brand-accent font-mono mt-0.5 flex-shrink-0">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-center text-xs text-brand-faint mt-6 font-mono" data-i18n="download_placeholder_note">下载遇到问题？前往 GitHub Releases 获取全部安装包（含 Apple Silicon arm64）。</p>
      <div class="text-center mt-3">
        <a href="https://github.com/yth1120/Auraxis-Agent/releases/latest" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-brand-accent hover:text-brand-ivory transition-colors font-mono">
          GitHub Releases ↗
        </a>
      </div>

      <!-- 命令行版本：独立仓库与独立发布节奏 -->
      <div class="mt-10 pt-8 border-t border-brand-border/60 max-w-3xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div>
            <h3 class="text-sm font-medium text-ivory flex items-center gap-2">
              <Terminal className="w-4 h-4 text-brand-accent" aria-hidden="true" />
              <span data-i18n="download_cli_title">Auraxis CLI</span>
            </h3>
            <p class="text-[13px] text-brand-muted mt-2 leading-relaxed" data-i18n="download_cli_desc">
              独立仓库的本地 Agent 命令行工作台，无需安装桌面端。npm 一键安装，或下载 8 个平台的原生二进制（含校验和）。
            </p>
          </div>
          <a href="https://github.com/yth1120/Auraxis-CLI/releases/latest" target="_blank" rel="noopener noreferrer" class="flex-shrink-0 inline-flex items-center gap-1.5 text-xs font-mono text-brand-accent hover:text-brand-ivory transition-colors">
            <span data-i18n="download_cli_release">CLI Releases ↗</span>
          </a>
        </div>

        <!-- 显眼的一条命令：整块可复制 -->
        <div class="mt-5 terminal-dark-box border border-brand-border rounded-xl px-4 sm:px-5 py-4 flex items-center justify-between gap-4 ring-1 ring-brand-accent/15">
          <code class="text-sm sm:text-base font-mono text-brand-ivory flex items-baseline gap-2.5 min-w-0">
            <span class="text-brand-accent select-none" aria-hidden="true">❯</span>
            <span class="truncate">npm i -g @auraxis/cli</span>
          </code>
          <button
            type="button"
            data-copy-text="npm i -g @auraxis/cli"
            class="flex-shrink-0 inline-flex items-center gap-1.5 text-[11px] font-mono text-brand-muted hover:text-brand-ivory transition-colors px-2.5 py-1.5 rounded-lg border border-brand-border hover:border-brand-accent/50 hover:bg-white/5"
            data-i18n-aria="dev_copy_button"
            data-i18n-title="dev_copy_title"
            aria-label="复制命令"
            title="点击复制"
          >
            <Copy className="w-3.5 h-3.5" aria-hidden="true" />
            <span data-i18n="download_cli_copy">复制</span>
          </button>
        </div>
        <p class="mt-2.5 text-[11px] font-mono text-brand-faint" data-i18n="download_cli_hint">
          装完全局命令 auraxis；也可下载 8 个平台的原生二进制（含 SHA256 校验和），无需 Node。
        </p>
      </div>
    </div>
  </div>
</section>
