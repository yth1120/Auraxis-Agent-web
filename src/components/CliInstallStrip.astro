---
import { Terminal, Copy, Download } from 'lucide-react';

const { labelKey = 'hero_cli_label', command = 'npm i -g @auraxis/cli' } = Astro.props as {
  labelKey?: string;
  command?: string;
};
---

<!-- 命令下载卡片：左侧列的主体内容 -->
<div class="terminal-dark-box border border-brand-border rounded-2xl p-6 sm:p-7 ring-1 ring-brand-accent/25 shadow-[0_24px_64px_-32px_rgba(0,0,0,0.65)]">
  <div class="flex items-center justify-between gap-3">
    <span class="inline-flex items-center gap-2 text-sm font-mono text-brand-accent">
      <Terminal className="w-4 h-4" aria-hidden="true" />
      <span data-i18n="hero_cli_title">Auraxis CLI</span>
    </span>
    <span class="text-[11px] font-mono text-brand-faint uppercase tracking-[0.18em]" data-i18n={labelKey}>命令行版本</span>
  </div>

  <div class="mt-5 flex items-center gap-3 rounded-xl border border-brand-border bg-black/30 px-3.5 py-3.5">
    <code class="min-w-0 flex-1 flex items-baseline gap-2.5 font-mono text-sm sm:text-base">
      <span class="text-brand-accent select-none flex-shrink-0" aria-hidden="true">❯</span>
      <span class="text-brand-ivory truncate">{command}</span>
    </code>
    <button
      type="button"
      data-copy-text={command}
      class="flex-shrink-0 inline-flex items-center gap-1.5 text-[11px] font-mono text-brand-muted hover:text-brand-ivory transition-colors px-2.5 py-1.5 rounded-lg border border-brand-border hover:border-brand-accent/50 hover:bg-white/5"
      data-i18n-aria="dev_copy_button"
      data-i18n-title="dev_copy_title"
      aria-label="复制命令"
      title="点击复制"
    >
      <Copy className="w-3.5 h-3.5" aria-hidden="true" />
      <span data-i18n="hero_cli_copy">复制</span>
    </button>
  </div>

  <dl class="mt-5 space-y-2.5 text-[13px]">
    <div class="flex items-start justify-between gap-4">
      <dt class="text-brand-faint flex-shrink-0" data-i18n="cli_dl_runtime_label">运行环境</dt>
      <dd class="text-brand-muted text-right" data-i18n="cli_dl_runtime">Node 22.12+ 或原生二进制（内置运行时）</dd>
    </div>
    <div class="flex items-start justify-between gap-4">
      <dt class="text-brand-faint flex-shrink-0" data-i18n="cli_dl_platforms_label">平台</dt>
      <dd class="text-brand-muted text-right" data-i18n="cli_dl_platforms">Windows / macOS / Linux · x64 / arm64 · glibc / musl</dd>
    </div>
    <div class="flex items-start justify-between gap-4">
      <dt class="text-brand-faint flex-shrink-0" data-i18n="cli_dl_license_label">许可</dt>
      <dd class="text-brand-muted text-right" data-i18n="cli_dl_license">MIT 开源 · 本地运行</dd>
    </div>
  </dl>

  <div class="mt-5 flex flex-wrap items-center gap-3">
    <a
      href="https://github.com/yth1120/Auraxis-CLI/releases/latest"
      target="_blank"
      rel="noopener noreferrer"
      class="bg-ink dark:bg-ivory hover:bg-black/90 dark:hover:bg-white/90 text-ivory dark:text-ink font-medium text-xs h-9 px-4 inline-flex items-center gap-2 rounded-md transition-colors"
    >
      <Download className="w-3.5 h-3.5" aria-hidden="true" />
      <span data-i18n="cli_binary_link">前往 GitHub Releases ↗</span>
    </a>
    <a
      href="https://github.com/yth1120/Auraxis-CLI#readme"
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-mono text-brand-muted hover:text-brand-ivory transition-colors"
      data-i18n="cli_dl_readme"
    >查看仓库 README ↗</a>
  </div>

  <p class="mt-4 text-[11px] font-mono text-brand-faint" data-i18n="cli_dl_note">
    附 SHA256SUMS.txt 校验和；npm 包名 @auraxis/cli，安装后命令为 auraxis。
  </p>
</div>
