---
import '../styles/global.css';

const SITE_URL = Astro.site?.href ?? 'https://yth1120.github.io/Auraxis-Agent-web/';
const OG_IMAGE_URL = new URL('auraxis-logo.png', SITE_URL).href;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Auraxis Agent — 桌面端智能体工作台 | Official Website</title>
    <meta name="description" content="Auraxis Agent v3.2.0 — 基于 Electron 的桌面端智能体工作台。编码 / 文档 / 自动化：Chat / Work / Code 三模式、统一 ReAct 步进引擎、多智能体调度、DeepSeek Harness / 飞书 Lark MCP、71 个内置工具、原生沙箱与 Eywa 溯源记忆。" />
    <meta name="keywords" content="Auraxis Agent, AI Agent, Agentic Workbench, Electron, ReAct, MCP, 智能体工作台" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon-96.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Auraxis Agent — 桌面端智能体工作台" />
    <meta property="og:description" content="Chat / Work / Code 三模式 · 统一 ReAct 步进引擎 · 71 个内置工具 · 文档生成与云连接器 · 原生沙箱 · 中英双语" />
