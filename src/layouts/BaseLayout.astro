---
import { TRANSLATIONS } from '../i18n/translations';
import '../styles/global.css';

// 英文词典单一来源：直接复用 src/i18n/translations.ts 的 en 对象，
// 避免内联副本与 TS 词典漂移（历史上漏键会导致切英文残留中文）。
const EN_JSON = JSON.stringify(TRANSLATIONS.en).replaceAll('<', '\\u003c');

const inlineScript = `(function(){
        document.documentElement.classList.add('js');
        // 主题预载（防 FOUC）：默认深色，跟随系统，localStorage 持久化
        var T=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
        document.documentElement.classList.toggle('dark',T==='dark');
        // 语言引导：英文词典由构建期从 translations.ts 注入，单一来源不漂移
        var L=localStorage.getItem('lang')||(navigator.language.startsWith('zh')?'zh':'en');
        var EN=${EN_JSON};
        window.__i18n=EN;
        if(L==='en'){document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('[data-i18n]').forEach(function(e){var k=e.getAttribute('data-i18n');if(EN[k])e.textContent=EN[k]})})}
      })();`;

const SITE_URL = Astro.site?.href ?? 'https://yth1120.github.io/Auraxis-Agent-web/';
const OG_IMAGE_URL = new URL('auraxis-logo.png', SITE_URL).href;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Auraxis Agent — 桌面端智能体工作台 | Official Website</title>
    <meta name="description" content="Auraxis Agent v3.4.0 — 基于 Electron 的桌面端智能体工作台。编码 / 文档 / 自动化：Chat / Work / Code 三模式、统一 ReAct 步进引擎、多智能体调度、DeepSeek V4.1 Flash 原生多模态、71 个内置工具、原生沙箱与 Eywa 溯源记忆。" />
    <script is:inline set:html={inlineScript}></script>
  </head>
  <body class="bg-brand-page dark:bg-brand-black text-ink dark:text-ivory font-sans transition-colors duration-200">
    <div class="fixed inset-0 grid-bg pointer-events-none z-0" aria-hidden="true"></div>
    <!-- Aura 紫灰状态微光：仅 3% 面积强调 -->
    <div class="aura-glow fixed top-0 left-1/4 w-96 h-96 bg-brand-accent/[0.07] dark:bg-brand-accent/[0.07] rounded-full blur-[120px] pointer-events-none transition-all" aria-hidden="true"></div>
    <div class="aura-glow fixed bottom-10 right-1/4 w-96 h-96 bg-brand-accent/[0.03] dark:bg-brand-accent/[0.03] rounded-full blur-[120px] pointer-events-none transition-all" aria-hidden="true"></div>
    <slot />

    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('reveal-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add('reveal-visible');
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -15% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
