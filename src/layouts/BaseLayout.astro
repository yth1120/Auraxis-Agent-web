    <meta property="og:type" content="website" />
    <meta property="og:title" content="Auraxis Agent — 桌面端编程助手" />
    <meta property="og:description" content="统一 ReAct 步进引擎 · 多智能体调度 · Code Mode · 63 个内置工具 · 原生沙箱 · 中英双语" />
