---
import ThemeToggle from '../react/ThemeToggle';
import LanguageToggle from '../react/LanguageToggle';
import { Github, Download } from 'lucide-react';

const REPO_URL = 'https://github.com/yth1120/Auraxis-Agent';

const NAV_LINKS = [
  { href: '#features', key: 'nav_features', label: '核心能力' },
  { href: '#demo', key: 'nav_demo', label: '实况演示' },
];
---

<header class="sticky top-0 z-50 bg-white/75 dark:bg-brand-black/75 backdrop-blur-xl border-b border-brand-hairline dark:border-brand-border transition-colors">
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between relative">
    <a href="#top" class="flex items-center gap-2.5 flex-shrink-0" aria-label="Auraxis 首页">
      <img src="/auraxis-logo.png" alt="Auraxis Logo" class="h-7 w-auto" />
      <span class="font-semibold text-base tracking-tight text-ink dark:text-ivory">Auraxis</span>
      <span class="text-[10px] text-brand-faint font-mono border border-brand-hairline dark:border-brand-border px-1.5 py-0.5 rounded-full">v2.0.1</span>
    </a>

    <!-- 居中导航 -->
    <nav class="absolute left-1/2 -translate-x-1/2 hidden lg:flex items-center gap-1 p-1 bg-black/[0.04] dark:bg-white/[0.04] border border-brand-hairline dark:border-brand-border rounded-full" aria-label="主导航">
      {NAV_LINKS.map(({ href, key, label }) => (
        <a
          href={href}
          data-i18n={key}
          class="px-3.5 h-8 inline-flex items-center text-[13px] font-medium text-brand-muted hover:text-ink dark:hover:text-ivory rounded-full transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 flex-shrink-0">
      <LanguageToggle client:idle />
      <ThemeToggle client:idle />

      <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="text-brand-muted hover:text-ink dark:hover:text-ivory transition-colors p-2" aria-label="Auraxis GitHub">
        <Github className="w-[18px] h-[18px]" aria-hidden="true" />
      </a>

      <a href="#download" data-i18n="nav_download" class="bg-ink dark:bg-ivory hover:bg-black/90 dark:hover:bg-white/90 text-ivory dark:text-ink font-medium text-xs px-4 h-9 inline-flex items-center gap-1.5 rounded-md">
        <Download className="w-4 h-4" aria-hidden="true" />
        免费下载
      </a>
    </div>
  </div>
</header>
