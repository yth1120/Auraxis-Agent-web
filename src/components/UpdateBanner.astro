<section
  id="update-banner"
  class="relative z-40 overflow-hidden bg-[#2563EB] dark:bg-[#1D4ED8] text-white shadow-[0_8px_24px_-12px_rgba(37,99,235,0.55)] dark:shadow-[0_8px_24px_-12px_rgba(0,0,0,0.55)] transition-all duration-500 ease-out"
  style="max-height: 0; opacity: 0;"
  data-i18n-aria="banner_label"
  aria-label="重点更新"
>
  <div class="max-w-6xl mx-auto px-6 py-2.5 flex items-center justify-between gap-4">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="text-sm leading-none flex-shrink-0" aria-hidden="true">🎉</span>
      <span class="flex-shrink-0 inline-flex items-center gap-1 text-[9px] font-mono text-white bg-white/15 border border-white/30 rounded-full px-2 py-0.5 font-medium">
        v3.0.1
      </span>
      <p class="text-xs text-white/90 truncate" data-i18n="banner_text">
        重点更新：Aqua 玻璃主题 · 壁纸设置 · 执行档位 / 运行权限弹窗重设计 · 侧边栏修复
      </p>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <a href="#download" data-i18n="banner_link" class="text-xs font-medium text-white/90 hover:text-white underline decoration-white/40 underline-offset-2 transition-colors whitespace-nowrap">
        查看详情
      </a>
      <button
        id="update-banner-close"
        type="button"
        data-i18n-aria="banner_close"
        aria-label="关闭横幅"
        class="text-white/70 hover:text-white transition-colors p-1 rounded-md hover:bg-white/15"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var bannerEl = document.getElementById('update-banner');
    if (!bannerEl) return;

    // 每次进入页面都自动弹出（不做持久化记忆）
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        bannerEl.style.maxHeight = bannerEl.scrollHeight + 'px';
        bannerEl.style.opacity = '1';
      });
    });

    var closeBtn = document.getElementById('update-banner-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        bannerEl.style.maxHeight = '0px';
        bannerEl.style.opacity = '0';
        setTimeout(function () { bannerEl.setAttribute('hidden', ''); }, 450);
      });
    }
  })();
</script>
