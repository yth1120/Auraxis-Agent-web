---
import TerminalSimulator from '../react/TerminalSimulator';
import { ArrowRight, BookOpen } from 'lucide-react';
---

<section id="top" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-24 pt-8">
  <div class="lg:col-span-6 space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-brand-accent/10 border border-brand-accent/25 rounded-full text-brand-muted dark:text-brand-muted text-xs font-mono">
      <span class="w-1.5 h-1.5 bg-brand-accent rounded-full" aria-hidden="true"></span>
      <span data-i18n="hero_badge">原生沙箱隔离 · 统一 ReAct 步进引擎</span>
    </div>

    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.08] text-ink dark:text-ivory">
      <span data-i18n="hero_title_line1">让 AI 智能体在桌面上</span><br />
      <span class="text-brand-accent" data-i18n="hero_title_line2">真正动手写代码</span>
    </h1>

    <p class="text-brand-muted text-base leading-relaxed max-w-xl" data-i18n="hero_description">
      Auraxis 是基于 Electron 的桌面端 Agentic 编程助手：聊天与智能体共用一套统一步进引擎，63 个内置工具、多智能体调度、Code Mode 工具编排与原生沙箱，让 AI 从「只说不做」变成「可审计地动手」。
    </p>

    <div class="flex items-center gap-3 pt-2">
      <a href="#download" data-i18n="hero_cta_download" class="bg-ink dark:bg-ivory hover:bg-black/90 dark:hover:bg-white/90 text-ivory dark:text-ink font-medium text-sm h-9 px-5 inline-flex items-center gap-2 rounded-md">
        <ArrowRight className="w-4 h-4" aria-hidden="true" />
        免费下载
      </a>
      <a href="#developer-docs" data-i18n="hero_cta_docs" class="border border-brand-hairline dark:border-brand-border hover:bg-black/5 dark:hover:bg-white/5 text-ink dark:text-ivory font-medium text-sm h-9 px-5 inline-flex items-center gap-2 rounded-md">
        <BookOpen className="w-4 h-4" aria-hidden="true" />
        查看文档
      </a>
    </div>

    <div class="grid grid-cols-4 gap-4 pt-6 border-t border-brand-hairline dark:border-brand-border/60">
      <div>
        <h4 class="text-xl font-semibold font-mono text-brand-accent" data-i18n="hero_stat_tools">63</h4>
        <p class="text-[11px] text-brand-muted" data-i18n="hero_stat_tools_sub">内置 AI 工具</p>
      </div>
      <div>
        <h4 class="text-xl font-semibold font-mono text-brand-accent" data-i18n="hero_stat_perms">3</h4>
        <p class="text-[11px] text-brand-muted" data-i18n="hero_stat_perms_sub">权限模式（ask/plan/afe）</p>
      </div>
      <div>
        <h4 class="text-xl font-semibold font-mono text-brand-accent" data-i18n="hero_stat_tests">1347</h4>
        <p class="text-[11px] text-brand-muted" data-i18n="hero_stat_tests_sub">测试用例 · 166 个文件</p>
      </div>
      <div>
        <h4 class="text-xl font-semibold font-mono text-brand-accent" data-i18n="hero_stat_sdk">2</h4>
        <p class="text-[11px] text-brand-muted" data-i18n="hero_stat_sdk_sub">TypeScript &amp; Python SDK</p>
      </div>
    </div>
  </div>

  <div id="react-demo" class="lg:col-span-6 relative">
    <TerminalSimulator client:visible />
  </div>
</section>
