---
import { RefreshCw, Workflow, Braces, ShieldCheck, Lock, Database, Puzzle, Sparkles, Code2, LayoutGrid, FileText, UserCircle } from 'lucide-react';

interface Pillar {
  icon: typeof RefreshCw;
  titleKey: string;
  descKey: string;
  title: string;
  desc: string;
}

const FEATURES: Pillar[] = [
  {
    icon: RefreshCw,
    titleKey: 'feature1_title',
    descKey: 'feature1_desc',
    title: '统一 ReAct 步进引擎',
    desc: '聊天与 Agent 共用 step-engine 单一步进循环，停止策略 / 上下文压缩 / 重试均为策略钩子；业务迭代上限 200 次，安全硬上限 500 次，API 失败 3 次指数退避重试。',
  },
  {
    icon: Workflow,
    titleKey: 'feature2_title',
    descKey: 'feature2_desc',
    title: '多智能体调度器',
    desc: '优先级队列（high/normal/low）、默认并发 3、状态机实时广播；三级偏差检测（L1 工具失败 / L2 连续停滞 / L3 Replan 重规划）与 5 分钟计划审批流。',
  },
  {
    icon: Braces,
    titleKey: 'feature3_title',
    descKey: 'feature3_desc',
    title: 'Code Mode',
    desc: 'RunCode 将 TypeScript 程序放入 worker 线程执行，每个 tools.Name() 子调用回穿完整权限管线；并发安全工具最多 8 路重叠、变异工具串行、硬超时可强杀。',
  },
  {
    icon: ShieldCheck,
    titleKey: 'feature4_title',
    descKey: 'feature4_desc',
    title: '三模态权限看门狗',
    desc: 'ask（默认）/ plan（计划审批）/ auto（全自动）三种审批策略；规则作用域 once/session/always；只读工具（Read/Grep/Glob）自动放行，危险调用必经拦截审查。',
  },
  {
    icon: Lock,
    titleKey: 'feature5_title',
    descKey: 'feature5_desc',
    title: '原生沙箱',
    desc: 'Windows restricted token / AppContainer、Linux、macOS 四后端命令级隔离，另加 Git worktree 沙箱（.auraxis-sandbox/task-<id>）为并发 Agent 提供隔离分支。',
  },
  {
    icon: Database,
    titleKey: 'feature7_title',
    descKey: 'feature7_desc',
    title: '持久化项目记忆',
    desc: 'Eywa 溯源记忆（M1–M4）：证据先于信念、不可变证据、规则信号与硬锚点校验，零 LLM 确定性读取路径；会话统一 append-only JSONL 事件日志 + SQLite 投影缓存 + FTS5 全文搜索。',
  },
  {
    icon: Puzzle,
    titleKey: 'feature6_title',
    descKey: 'feature6_desc',
    title: 'MCP + 插件系统',
    desc: 'MCP 客户端（JSON-RPC over stdio）；渲染层插件提供 commands/tools/hooks/ui 四类扩展点，载入前扫描危险模式并需要用户确认。',
  },
  {
    icon: Sparkles,
    titleKey: 'feature8_title',
    descKey: 'feature8_desc',
    title: 'DeepSeek 官方深度能力',
    desc: '默认 DeepSeek（内置 deepseek-v4-flash / v4-pro），支持 reasoning effort、strict tools、FIM 补全、计划 JSON 模式与最大 384K 输出；同时兼容 OpenAI / Anthropic 消息格式。',
  },
  {
    icon: Code2,
    titleKey: 'feature9_title',
    descKey: 'feature9_desc',
    title: 'TS & Python 双 SDK',
    desc: 'TypeScript SDK（TCP JSON-RPC）与 Python SDK，另有 headless CLI（--run / --sdk / --acp / --plugin）与 ACP 协议支持，可用于自动化集成。',
  },
  {
    icon: LayoutGrid,
    titleKey: 'feature10_title',
    descKey: 'feature10_desc',
    title: 'Chat / Work / Code 三模式',
    desc: '三种产品形态共用同一套 ReAct 步进引擎，模式状态互不污染：Chat 会话时间线、Work 文档协作（代码只读硬边界）、Code Mode worker 线程工具编排。',
  },
  {
    icon: FileText,
    titleKey: 'feature11_title',
    descKey: 'feature11_desc',
    title: '文档生成与云连接器',
    desc: 'ReadDocument / WriteDocument 读写 Word、Excel、PPT、PDF（CJK 字体自动嵌入）；Slack / Google Drive / Notion 连接器令牌经 safeStorage 加密保存。',
  },
  {
    icon: UserCircle,
    titleKey: 'feature12_title',
    descKey: 'feature12_desc',
    title: '本地账户与分层设置',
    desc: '本地优先账户（scrypt 密码哈希）、分层 Instructions 面板、连接器 / MCP / 插件 / 权限档案管理，以及内嵌真实测试覆盖率报告。',
  },
];
---

<section id="solution" class="py-20 border-t border-brand-hairline dark:border-brand-border/80 transition-colors">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal text-center max-w-3xl mx-auto mb-14">
      <div class="text-xs font-mono text-brand-accent tracking-[0.2em] uppercase mb-4">Features</div>
      <h2 class="text-3xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="solution_title">核心能力</h2>
      <p class="text-brand-muted mt-3" data-i18n="solution_subtitle">Auraxis Agent 把聊天与 Agent 执行收敛到同一套 ReAct 步进引擎，工具、调度与沙箱都在本地运行。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {FEATURES.map(({ icon: Icon, titleKey, descKey, title, desc }, i) => (
        <div class="reveal bg-white dark:bg-brand-card border border-brand-hairline dark:border-brand-border rounded-xl p-6 hover:border-brand-accent/40 transition-colors" style={`--reveal-delay: ${i * 110}ms`}>
          <div class="w-11 h-11 rounded-md bg-brand-accent/10 flex items-center justify-center text-brand-accent mb-4">
            <Icon className="w-5 h-5" aria-hidden="true" />
          </div>
          <h3 class="text-base font-medium text-ink dark:text-ivory" data-i18n={titleKey}>{title}</h3>
          <p class="text-sm text-brand-muted mt-2 leading-relaxed" data-i18n={descKey}>{desc}</p>
        </div>
      ))}
    </div>

    <!-- 界面与工程细节：一行小字，避免堆叠成卡片 -->
    <p class="reveal mt-8 text-center text-xs text-brand-muted leading-relaxed max-w-3xl mx-auto" data-i18n="ui_details">
      界面与工程细节：终端抽屉 · PTY/SSH 会话 · 后台与定时任务 · 图片输入 · 撤销快照 · 冲突检测 · 中英双语界面 · 深浅主题（Windows 11 Acrylic）· 可选遥测
    </p>
  </div>
</section>
