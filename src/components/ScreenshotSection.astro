---
const BASE = import.meta.env.BASE_URL;
---

<section id="screenshot" class="py-16 border-t border-brand-hairline dark:border-brand-border/80 transition-colors">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal terminal-dark-box border border-brand-border rounded-2xl overflow-hidden">
      <!-- 窗口标题栏：保持终端/IDE 风格 -->
      <div class="bg-brand-black px-4 py-2.5 border-b border-brand-border flex items-center gap-3">
        <div class="flex items-center gap-1.5" aria-hidden="true">
          <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
        </div>
        <span class="text-[10px] font-mono text-brand-muted" data-i18n="screenshot_caption">Auraxis Agent — 桌面端界面预览</span>
      </div>
      <img
        src={`${BASE}screenshots/auraxis-ui.png`}
        alt="Auraxis Agent 桌面端界面预览"
        data-i18n-alt="screenshot_alt"
        width="1920"
        height="1032"
        loading="lazy"
        class="w-full h-auto block"
      />
    </div>
    <p class="text-center text-xs text-brand-muted mt-3" data-i18n="screenshot_note">界面截图来自项目 README，实际效果以最新版本为准。</p>
  </div>
</section>
