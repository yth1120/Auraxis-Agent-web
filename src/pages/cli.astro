---
// Auraxis CLI 独立页：安装、能力、用法示例与命令速查
export const prerender = true;

import Layout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CliInstallStrip from '../components/CliInstallStrip.astro';
import { SquareTerminal, ShieldCheck, Layers, Plug, Gauge, Cpu, Terminal } from 'lucide-react';

const BASE = import.meta.env.BASE_URL;
const RELEASES = 'https://github.com/yth1120/Auraxis-CLI/releases/latest';
const SHOT = `${BASE}screenshots/cli-session.png`;

const COMMANDS = [
  '/model', '/permission', '/reasoning', '/sandbox', '/provider', '/api-family', '/vision-detail',
  '/strict-tools', '/tool-choice', '/api-base', '/max-tokens', '/context-budget', '/theme',
  '/mcp', '/skills', '/plugins', '/memory', '/files', '/symbol',
  '/agents', '/review', '/git', '/run', '/code', '/worktree', '/checkpoint', '/complete', '/fim',
  '/status', '/tools', '/doctor', '/sessions', '/session', '/history', '/audit', '/config', '/help',
];

const SCENARIOS = [
  { cmd: 'auraxis', descKey: 'cli_cmd_run', desc: '交互式 TUI，进入后直接对话' },
  { cmd: 'auraxis --run "修复登录超时"', descKey: 'cli_cmd_headless', desc: '无头执行一次任务，可接 CI' },
  { cmd: 'auraxis --code-file scripts/agent.ts', descKey: 'cli_cmd_code', desc: '以 Code Mode 运行编排程序' },
  { cmd: 'auraxis --sessions', descKey: 'cli_cmd_sessions', desc: '查看并恢复历史会话' },
  { cmd: 'auraxis --doctor', descKey: 'cli_cmd_doctor', desc: '检查模型、密钥与工具配置' },
];

const FEATURES = [
  {
    Icon: SquareTerminal,
    titleKey: 'cli_f1_title',
    descKey: 'cli_f1_desc',
    title: '终端交互',
    desc: '流式文本与思考折叠、执行时间轴、输入联想与命令面板，都是为长时间跑任务设计的。',
  },
  {
    Icon: Layers,
    titleKey: 'cli_f2_title',
    descKey: 'cli_f2_desc',
    title: '两种运行方式',
    desc: '交互 TUI 或 --run 无头执行；无头模式输出 NDJSON，方便脚本和流水线消费。',
  },
  {
    Icon: ShieldCheck,
    titleKey: 'cli_f3_title',
    descKey: 'cli_f3_desc',
    title: '安全边界',
    desc: 'ask / plan / auto 审批策略叠加 read / workspace-write / full / container 沙箱，危险工具逐次确认。',
  },
  {
    Icon: Plug,
    titleKey: 'cli_f4_title',
    descKey: 'cli_f4_desc',
    title: '可扩展',
    desc: 'MCP 服务、技能、插件、Hooks 与自定义模型都能接入，配置与桌面端同源。',
  },
  {
    Icon: Cpu,
    titleKey: 'cli_f5_title',
    descKey: 'cli_f5_desc',
    title: '模型与协议',
    desc: '默认 deepseek-flash，支持 Chat Completions / Responses / Anthropic 三种协议与思考强度切换。',
  },
  {
    Icon: Gauge,
    titleKey: 'cli_f6_title',
    descKey: 'cli_f6_desc',
    title: '上下文管理',
    desc: '上下文预算、超限自动摘要、工具输出裁剪与会话恢复，长任务不会中途失忆。',
  },
];

const STEPS = [
  { n: '1', cmd: 'npm i -g @auraxis/cli', key: 'cli_step1', desc: '全局安装，得到 auraxis 命令' },
  { n: '2', cmd: 'auraxis --set-api-key sk-...', key: 'cli_step2', desc: '加密保存 API Key 到本机' },
  { n: '3', cmd: 'auraxis', key: 'cli_step3', desc: '进入交互模式，直接开始任务' },
];
---

<Layout>
  <Header />

  <main class="relative z-10 pt-28">
    <!-- Hero：左安装命令 + 右终端截图 -->
    <section class="max-w-6xl mx-auto px-6 pb-12">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.05fr] gap-10 lg:gap-12 items-center">
        <div>
          <div class="text-xs font-mono text-brand-accent tracking-[0.2em] uppercase mb-4" data-i18n="cli_kicker">Auraxis CLI</div>
          <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.15] text-ink dark:text-ivory" data-i18n="cli_page_title">
            终端里的本地 Agent 工作台
          </h1>
          <p class="mt-5 text-brand-muted text-base leading-relaxed" data-i18n="cli_page_desc">
            Auraxis CLI 是独立发布的命令行版本：不依赖桌面端，直接在你自己的终端里跑同一套 ReAct 工具循环、Code Mode 与权限审批。模型、协议、沙箱与思考强度都可以按任务切换。
          </p>

          <div class="mt-7">
            <CliInstallStrip labelKey="cli_install_label" />
          </div>

          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2.5 text-xs font-mono text-brand-faint">
            <span data-i18n="cli_meta_node">Node 22.12+ 或原生二进制（内置运行时）</span>
            <span class="text-brand-hairline">|</span>
            <a href={RELEASES} target="_blank" rel="noopener noreferrer" class="text-brand-accent hover:text-brand-ivory transition-colors" data-i18n="cli_meta_releases">下载原生二进制 ↗</a>
          </div>
          <p class="mt-2 text-[11px] font-mono text-brand-faint" data-i18n="cli_meta_platforms">
            Windows / macOS / Linux · x64 / arm64 · glibc / musl
          </p>
        </div>

        <div class="reveal" style="--reveal-delay: 240ms">
          <figure class="terminal-dark-box border border-brand-border rounded-2xl overflow-hidden shadow-[0_24px_80px_-32px_rgba(0,0,0,0.65)]">
            <img
              src={SHOT}
              alt="Auraxis CLI 交互模式：执行时间轴、工具调用与状态行"
              data-i18n-alt="cli_shot_alt"
              width="964"
              height="684"
              class="w-full h-auto block"
              loading="eager"
            />
            <figcaption class="px-4 py-3 border-t border-brand-border/70 text-[11px] font-mono text-brand-muted" data-i18n="cli_shot_caption">
              一次真实运行：写入文件 → 读回确认，执行时间轴与耗时都来自实际输出。
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 能力 -->
    <section class="max-w-6xl mx-auto px-6 py-12 border-t border-brand-hairline dark:border-brand-border/70">
      <h2 class="text-2xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="cli_features_title">核心能力</h2>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {FEATURES.map(({ Icon, titleKey, descKey, title, desc }) => (
          <div class="bg-white dark:bg-brand-card border border-brand-hairline dark:border-brand-border rounded-xl p-5">
            <div class="w-8 h-8 rounded-md bg-brand-accent/10 flex items-center justify-center text-brand-accent mb-3.5">
              <Icon className="w-4 h-4" aria-hidden="true" />
            </div>
            <h3 class="text-sm font-medium text-ink dark:text-ivory" data-i18n={titleKey}>{title}</h3>
            <p class="mt-1.5 text-[13px] text-brand-muted leading-relaxed" data-i18n={descKey}>{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 用法示例 -->
    <section class="max-w-6xl mx-auto px-6 py-12 border-t border-brand-hairline dark:border-brand-border/70">
      <h2 class="text-2xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="cli_usage_title">常用用法</h2>
      <p class="mt-2 text-sm text-brand-muted" data-i18n="cli_usage_subtitle">交互模式下直接输入 / 开头的命令；无头模式用参数控制一次执行。</p>
      <div class="mt-7 grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-3.5">
        {SCENARIOS.map(({ cmd, descKey, desc }) => (
          <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 border-b border-brand-hairline dark:border-brand-border/50 pb-3.5">
            <code class="text-[13px] font-mono text-brand-ivory terminal-dark-box border border-brand-border rounded-lg px-3 py-2 flex-1 min-w-0 overflow-x-auto whitespace-nowrap">{cmd}</code>
            <span class="text-xs text-brand-muted sm:text-right sm:w-44 flex-shrink-0" data-i18n={descKey}>{desc}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 命令速查 -->
    <section class="max-w-6xl mx-auto px-6 py-12 border-t border-brand-hairline dark:border-brand-border/70">
      <div class="flex items-baseline justify-between gap-4 flex-wrap">
        <h2 class="text-2xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="cli_slash_title">交互命令</h2>
        <span class="text-xs font-mono text-brand-faint" data-i18n="cli_slash_note">输入 / 即出现联想面板，↑↓ 选择</span>
      </div>
      <div class="mt-7 flex flex-wrap gap-2">
        {COMMANDS.map((cmd) => (
          <code class="text-[11px] font-mono text-brand-muted border border-brand-hairline dark:border-brand-border rounded-md px-2 py-1 hover:text-brand-accent hover:border-brand-accent/40 transition-colors">{cmd}</code>
        ))}
      </div>
      <p class="mt-5 text-xs text-brand-faint" data-i18n="cli_slash_more">完整命令与选项见 <a class="text-brand-accent hover:text-brand-ivory" href="https://github.com/yth1120/Auraxis-CLI#readme" target="_blank" rel="noopener noreferrer">仓库 README</a>。</p>
    </section>

    <!-- 快速开始 + 下载 -->
    <section class="max-w-6xl mx-auto px-6 py-12 border-t border-brand-hairline dark:border-brand-border/70">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-ink dark:text-ivory" data-i18n="cli_start_title">快速开始</h2>
          <ol class="mt-6 space-y-4">
            {STEPS.map(({ n, cmd, key, desc }) => (
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-accent/12 text-brand-accent text-[11px] font-mono flex items-center justify-center mt-1.5">{n}</span>
                <div class="min-w-0 flex-1">
                  <code class="block text-[13px] font-mono text-brand-ivory terminal-dark-box border border-brand-border rounded-lg px-3 py-2 overflow-x-auto whitespace-nowrap">{cmd}</code>
                  <p class="mt-1.5 text-xs text-brand-muted leading-relaxed" data-i18n={key}>{desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="terminal-dark-box border border-brand-border rounded-2xl p-5">
          <h3 class="text-sm font-medium text-brand-ivory flex items-center gap-2">
            <Terminal className="w-4 h-4 text-brand-accent" aria-hidden="true" />
            <span data-i18n="cli_binary_title">原生二进制</span>
          </h3>
          <p class="mt-2.5 text-[13px] text-brand-muted leading-relaxed" data-i18n="cli_binary_desc">
            8 个平台的自包含可执行文件，内置运行时，不需要 Node。附带 SHA256SUMS.txt 校验和。
          </p>
          <ul class="mt-4 space-y-2 text-[12px] font-mono text-brand-muted">
            <li class="flex justify-between gap-4"><span>auraxis-windows-x64.exe</span><span class="text-brand-faint">x64</span></li>
            <li class="flex justify-between gap-4"><span>auraxis-darwin-arm64</span><span class="text-brand-faint">Apple Silicon</span></li>
            <li class="flex justify-between gap-4"><span>auraxis-linux-x64</span><span class="text-brand-faint">glibc</span></li>
            <li class="flex justify-between gap-4"><span>auraxis-linux-x64-musl</span><span class="text-brand-faint">musl</span></li>
          </ul>
          <a href={RELEASES} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-1.5 text-xs font-mono text-brand-accent hover:text-brand-ivory transition-colors" data-i18n="cli_binary_link">
            前往 GitHub Releases ↗
          </a>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="https://github.com/yth1120/Auraxis-CLI" target="_blank" rel="noopener noreferrer" class="bg-ink dark:bg-ivory hover:bg-black/90 dark:hover:bg-white/90 text-ivory dark:text-ink font-medium text-sm h-10 px-6 inline-flex items-center gap-2 rounded-md transition-colors" data-i18n="cli_cta_repo">
          查看源码
        </a>
        <a href={BASE} class="border border-brand-hairline dark:border-brand-border hover:bg-black/5 dark:hover:bg-white/5 text-ink dark:text-ivory font-medium text-sm h-10 px-6 inline-flex items-center gap-2 rounded-md transition-colors" data-i18n="cli_cta_back">
          返回桌面端介绍
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // 复制安装命令：与全局 data-copy-text 行为一致，复制后短暂显示对勾
  document.querySelectorAll<HTMLElement>('[data-copy-text]').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.getAttribute('data-copy-text');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const icon = button.querySelector('svg');
        const label = button.querySelector('span:last-child');
        const originalLabel = label?.textContent ?? '';
        if (icon) {
          const original = icon.outerHTML;
          icon.outerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg>';
          setTimeout(() => {
            const next = button.querySelector('svg');
            if (next) next.outerHTML = original;
          }, 1500);
        }
        if (label && originalLabel) {
          label.textContent = '✓';
          setTimeout(() => {
            label.textContent = originalLabel;
          }, 1500);
        }
      } catch {
        /* 剪贴板不可用时保持原样 */
      }
    });
  });
</script>
